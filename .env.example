# Copy to .env.local for local development (.env.local is git-ignored).
# Use the DEVELOPMENT Supabase project's values here, never production's.
# Find them in Supabase: Project Settings -> API Keys, and Project Settings -> Data API.

# Public: safe in the browser. Database access rules protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SECRET: server-only. Bypasses all access rules. Used only to invite and block users.
# Never prefix with NEXT_PUBLIC_, never commit it, never paste it into chat.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Base URL used in invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
